LLM_PROVIDER=auto
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
OLLAMA_MODEL=llama3.2

RAG_ENABLED=true
RAG_TOP_K=4
RAG_RETRIEVAL_MODE=embedding
RAG_CANDIDATE_POOL=3000
DAIL_TWO_PASS=false
DAIL_SKELETON_THRESHOLD=0.85
RAG_CROSS_DOMAIN=false
# For DAIL-style Spider benchmark, leave EMBED_MODEL unset to use sentence-transformers/all-mpnet-base-v2.
# For lower-resource app retrieval, default is all-MiniLM-L6-v2.
# EMBED_MODEL=all-MiniLM-L6-v2
# Optional override. By default the app searches the local workspace for this path.
# SPIDER_DATA_DIR=C:\Users\ADMIN\Documents\Convertional ai for data analysis\LLM to SQL\spider_data
